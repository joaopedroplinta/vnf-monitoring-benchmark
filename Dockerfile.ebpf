FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    bpfcc-tools \
    linux-headers-generic \
    net-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install bcc

WORKDIR /ebpf
COPY ebpf/monitor_bcc.py .

CMD ["python3", "monitor_bcc.py"]