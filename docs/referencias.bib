@inproceedings{10.1109/NOMS47738.2020.9110434,
author = {Cassagnes, Cyril and Trestioreanu, Lucian and Joly, Clement and State, Radu},
title = {The rise of eBPF for non-intrusive performance monitoring},
year = {2020},
